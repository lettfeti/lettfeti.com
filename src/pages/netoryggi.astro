      .tile .s { font-size: 0.8125rem; color: var(--muted); line-height: 1.35; }
      .tile:hover { border-color: var(--accent-line); }
      .tile:has(input:checked) { border-color: var(--accent); background: var(--accent-soft); }
      .tile:has(input:checked) .box { background: var(--accent); border-color: var(--accent); }
      .tile:has(input:checked) .box svg { opacity: 1; }
      .tile:has(input:focus-visible) { outline: 3px solid var(--focus); outline-offset: 2px; }

      #cards { display: grid; gap: 16px; }
      .js .card:not(.on) { display: none; }
      .empty { background: var(--surface); border: 1.5px dashed var(--accent-line); border-radius: 14px; padding: 28px 20px; text-align: center; color: var(--muted); }
      .empty strong { display: block; color: var(--ink); font-size: 1.0625rem; }

      .card { background: var(--surface); border: 1px solid var(--line); border-radius: 16px; padding: clamp(18px, 3.4vw, 26px); display: grid; gap: 14px; box-shadow: 0 1px 2px var(--shadow); }
      .card > * { min-width: 0; margin: 0; }
      .c-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 4px 16px; }
      .c-group { margin: 0; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
      .c-head h3 { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.35rem, 3.6vw, 1.6rem); line-height: 1.15; margin: 0; }
      .src { font-size: 0.875rem; font-weight: 500; white-space: nowrap; }
      .setup { display: flex; gap: 10px; align-items: flex-start; background: var(--accent-soft); border-radius: 12px; padding: 12px 14px; }
      .setup .tag { flex: none; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--accent-ink); padding-top: 2px; }
      .setup > div { display: grid; gap: 6px; min-width: 0; }
      .setup p { margin: 0; }
