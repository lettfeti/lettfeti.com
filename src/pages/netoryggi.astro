<!DOCTYPE html>
<html lang="is">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Netöryggi barna: stillingar fyrir foreldra</title>
    <meta name="description" content="Hakaðu við tækin sem barnið notar og fáðu stuttar leiðbeiningar um foreldrastillingar á iPhone, Android, tölvum, PlayStation, Xbox, Switch og Fortnite." />
    <meta property="og:title" content="Netöryggi barna" />
    <meta property="og:description" content="Foreldrastillingar tæki fyrir tæki: skjátími, samþykki, aldursmörk og spjall." />
    <meta property="og:url" content="https://www.lettfeti.com/netoryggi" />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <script defer src="/_vercel/insights/script.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Roboto+Slab:wght@700&display=swap" />
    <style is:inline>
      /* Layout: one calm column. Pick devices, read short cards, open details only when needed. Light only. */
      *, *::before, *::after { box-sizing: border-box; }
      :root {
        color-scheme: light;
        --bg: #F8F8FA;
        --surface: #FFFFFF;
        --ink: #18181E;
        --muted: #55536B;
        --line: #E2E2E9;
        --code-bg: #F2F1F8;
        --accent: #5A4DDE;
        --accent-ink: #342B99;
        --accent-soft: #EEECFC;
        --accent-line: #B9B2F1;
        --on-accent: #FFFFFF;
        --focus: #F2A900;
        --shadow: rgba(24, 24, 30, 0.07);
        --sleep: #2F5DA8;   --sleep-soft: #E9F0FA;
        --approve: #23774A; --approve-soft: #E6F3EB;
        --age: #9C5A00;     --age-soft: #FBF0DF;
        --chat: #A8327A;    --chat-soft: #FAEAF3;
        --calls: #4B5563;   --calls-soft: #EEF0F3;
        --net: #0E6E7C;     --net-soft: #E2F2F4;
        --font-body: 'Poppins', system-ui, sans-serif;
        --font-display: 'Roboto Slab', Georgia, serif;
        --font-mono: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
      }
      html { background: var(--bg); color: var(--ink); font-family: var(--font-body); font-size: 16px; line-height: 1.6; -webkit-font-smoothing: antialiased; }
      body { margin: 0; background: var(--bg); padding-inline: 16px; padding-block: 0; }
      main { max-width: 820px; margin: 0 auto; padding-block: 32px 150px; display: grid; gap: 40px; }
      main > * { min-width: 0; }
      a { color: var(--accent); text-underline-offset: 2px; }
      a:focus-visible, button:focus-visible, summary:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; border-radius: 6px; }
      .print-only { display: none; }

      .back { font-size: 0.875rem; font-weight: 500; color: var(--muted); text-decoration: none; }
      .top { display: grid; gap: 14px; }
      .eyebrow { margin: 0; font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); }
      h1 { font-family: var(--font-display); font-weight: 700; font-size: clamp(2rem, 6vw, 2.75rem); line-height: 1.1; margin: 0; text-wrap: balance; }
      .lead { margin: 0; max-width: 58ch; font-size: 1.0625rem; }
      .legend { display: flex; flex-wrap: wrap; gap: 8px; margin: 4px 0 0; padding: 0; list-style: none; }
