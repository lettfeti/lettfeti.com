      .badge { flex: none; width: 28px; height: 28px; border-radius: 8px; display: grid; place-items: center; background: var(--c); color: var(--on-accent); font-weight: 700; font-size: 0.6875rem; letter-spacing: -0.02em; }
      .badge svg { width: 16px; height: 16px; }
      .k-sleep { --c: var(--sleep); --soft: var(--sleep-soft); }
      .k-approve { --c: var(--approve); --soft: var(--approve-soft); }
      .k-age { --c: var(--age); --soft: var(--age-soft); }
      .k-chat { --c: var(--chat); --soft: var(--chat-soft); }
      .k-calls { --c: var(--calls); --soft: var(--calls-soft); }
      .k-net { --c: var(--net); --soft: var(--net-soft); }

      h2 { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.35rem, 3.6vw, 1.65rem); line-height: 1.2; margin: 0; }
      .sec { display: grid; gap: 16px; }
      .sec-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 6px 16px; }
      .sec-head p { margin: 0; color: var(--muted); font-size: 0.9375rem; }
      .linkbtn { font: inherit; font-size: 0.9375rem; background: none; border: 0; padding: 4px 0; color: var(--accent); text-decoration: underline; text-underline-offset: 2px; cursor: pointer; }

      .grp { border: 0; margin: 0; padding: 0; min-width: 0; }
      .grp + .grp { margin-top: 18px; }
      .grp legend { padding: 0; margin-bottom: 10px; display: flex; align-items: center; gap: 8px; font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
      .grp legend svg { width: 20px; height: 20px; color: var(--accent); }
      .tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(165px, 1fr)); gap: 10px; }
      .tile { position: relative; display: flex; gap: 12px; align-items: flex-start; padding: 14px; min-height: 64px; background: var(--surface); border: 1.5px solid var(--line); border-radius: 12px; cursor: pointer; }
      .tile input { position: absolute; opacity: 0; width: 1px; height: 1px; margin: 0; }
      .tile .box { flex: none; width: 24px; height: 24px; margin-top: 1px; border: 2px solid var(--accent-line); border-radius: 7px; display: grid; place-items: center; background: var(--surface); }
      .tile .box svg { width: 15px; height: 15px; opacity: 0; color: var(--on-accent); }
      .tile .txt { display: grid; min-width: 0; }
