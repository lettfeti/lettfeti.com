      .row .lbl { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; color: var(--c); line-height: 1.4; }
      .row .val { font-size: 0.9375rem; line-height: 1.5; min-width: 0; }

      code { font-family: var(--font-mono); font-size: 0.82em; background: var(--code-bg); border: 1px solid var(--line); border-radius: 5px; padding: 0.06em 0.36em; color: var(--ink); overflow-wrap: break-word; }

      .apps { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; border-top: 1px solid var(--line); }
      .apps li { display: grid; grid-template-columns: minmax(92px, 9rem) 1fr; gap: 2px 14px; padding: 10px 0; border-bottom: 1px solid var(--line); font-size: 0.9375rem; }
      .apps .nm { display: grid; align-content: start; }
      .apps .nm a { font-weight: 600; }
      .apps .age { font-size: 0.8125rem; color: var(--muted); line-height: 1.35; }
      .apps .where { min-width: 0; }

      .scenario { border: 1.5px solid var(--chat-soft); background: var(--surface); border-radius: 14px; padding: 14px 16px; display: grid; gap: 10px; }
      .scenario h4 { margin: 0; font-size: 1rem; font-weight: 700; color: var(--chat); }

      ol.steps { list-style: none; margin: 0; padding: 0; counter-reset: s; display: grid; gap: 10px; }
      ol.steps > li { counter-increment: s; display: grid; grid-template-columns: 26px 1fr; gap: 10px; font-size: 0.9375rem; }
      ol.steps > li::before { content: counter(s); width: 24px; height: 24px; border-radius: 50%; background: var(--accent-soft); color: var(--accent-ink); font-weight: 700; font-size: 0.8125rem; display: grid; place-items: center; }
      ol.steps > li > div { min-width: 0; }
      ul.sub, ul.plain { margin: 6px 0 0; padding-left: 20px; display: grid; gap: 4px; font-size: 0.9375rem; }
      ul.plain { margin: 0; }

      details { border-top: 1px solid var(--line); padding-top: 12px; }
      summary { cursor: pointer; font-weight: 600; color: var(--accent); list-style: none; display: inline-flex; align-items: center; gap: 6px; }
      summary::-webkit-details-marker { display: none; }
      summary::before { content: '+'; display: inline-grid; place-items: center; width: 22px; height: 22px; border-radius: 6px; background: var(--accent-soft); color: var(--accent-ink); font-weight: 700; }
      details[open] summary::before { content: '–'; }
      .det { display: grid; gap: 12px; margin-top: 14px; }
      .det h4 { margin: 4px 0 0; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent-ink); }
      .note { margin: 0; font-size: 0.875rem; color: var(--muted); }

      .contact { background: var(--accent-soft); border-radius: 16px; padding: clamp(18px, 3.4vw, 26px); display: grid; gap: 6px; }
      .contact p { margin: 0; }
      .contact .row2 { display: flex; flex-wrap: wrap; gap: 2px 22px; align-items: baseline; }
      .contact .big { font-family: var(--font-display); font-size: 1.5rem; font-weight: 700; font-variant-numeric: tabular-nums; }
      .fine { font-size: 0.8125rem; color: var(--muted); }

      .bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 10; background: var(--surface); border-top: 1px solid var(--line); box-shadow: 0 -8px 24px var(--shadow); padding: 10px 16px calc(10px + env(safe-area-inset-bottom, 0px)); }
      .bar-in { max-width: 820px; margin: 0 auto; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 16px; }
      .bar-info { display: grid; min-width: 0; }
      #count { margin: 0; font-weight: 600; }
      #status { margin: 0; font-size: 0.8125rem; color: var(--muted); min-height: 1.2em; }
      .actions { display: flex; flex-wrap: wrap; gap: 8px; }
      .btn { font: inherit; font-size: 0.9375rem; font-weight: 600; min-height: 46px; padding: 8px 16px; border-radius: 10px; border: 1.5px solid var(--accent); background: var(--surface); color: var(--accent-ink); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 8px; }
      .btn svg { width: 18px; height: 18px; }
      .btn.primary { background: var(--accent); color: var(--on-accent); }
      .btn:disabled { opacity: 0.45; cursor: not-allowed; }

      @media (prefers-reduced-motion: no-preference) {
        .tile, .tile .box, .btn { transition: background-color 0.15s ease, border-color 0.15s ease; }
      }
      @media (max-width: 520px) {
        .actions { width: 100%; }
        .actions .btn { flex: 1; }
        .apps li { grid-template-columns: 1fr; }
        .apps .nm { display: flex; flex-wrap: wrap; gap: 0 8px; align-items: baseline; }
      }

      @media print {
        body { background: #fff; padding: 0; }
        main { padding: 0; gap: 18px; max-width: none; }
        .back, .picker-sec, .bar, .legend, .lead, .src, summary, .empty, .sec-head p { display: none !important; }
        .print-only { display: block; margin: 0; font-size: 0.875rem; color: var(--muted); }
        .card { box-shadow: none; border: 1px solid #ccc; break-inside: auto; }
        .row, ol.steps > li, .setup, .scenario, .apps li { break-inside: avoid; }
        h3, h4, .c-head { break-after: avoid; }
        details { border: 0; padding: 0; }
        .det { margin-top: 0; }
        a { color: inherit; text-decoration: none; }
        .contact { background: none; border: 1px solid #ccc; }
      }
    </style>
  </head>
  <body>
    <main>
      <a class="back" href="/">← lettfeti.com</a>

      <header class="top">
        <p class="eyebrow">Fyrir foreldra · október 2026</p>
        <h1>Netöryggi barna</h1>
        <p class="print-only">www.lettfeti.com/netoryggi</p>
        <p class="lead">Hakaðu við tækin og leikina sem barnið notar. Fyrir hvert tæki sérðu hvar mikilvægustu stillingarnar eru.</p>
        <ul class="legend" aria-label="Stillingarnar">
          {['sleep', 'approve', 'age', 'chat'].map((k) => (
            <li class={`k-${k}`}><span class="badge" set:html={ICONS[k]} />{LABELS[k]}</li>
          ))}
        </ul>
      </header>

      <section class="sec picker-sec" aria-labelledby="h-pick">
        <div class="sec-head">
          <h2 id="h-pick">1. Hvað notar barnið?</h2>
          <button type="button" class="linkbtn" id="clear">Hreinsa val</button>
        </div>
        <div id="picker">
          {GROUPS.map((g) => (
            <fieldset class="grp">
              <legend>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={g.icon} />
                {g.name}
              </legend>
              <div class="tiles">
                {DEVICES.filter((d) => d.group === g.id).map((d) => (
                  <label class="tile" for={`t-${d.id}`}>
                    <input type="checkbox" id={`t-${d.id}`} value={d.id} />
                    <span class="box" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
                    </span>
                    <span class="txt"><span class="n">{d.tile}</span><span class="s">{d.sub}</span></span>
                  </label>
                ))}
              </div>
            </fieldset>
          ))}
        </div>
      </section>

      <section class="sec" aria-labelledby="h-res">
        <div class="sec-head">
          <h2 id="h-res">2. Stillingarnar</h2>
          <p>Valmyndir eru á ensku. [barn] er nafn barnsins.</p>
        </div>
        <div id="cards">
          <div class="empty" id="empty" hidden><strong>Ekkert valið enn</strong>Hakaðu við tækin hér að ofan.</div>
          {DEVICES.map((d) => (
            <article class="card" id={d.id} data-device={d.id}>
              <div class="c-head">
                <div>
                  <p class="c-group">{groupName(d.group)}</p>
                  <h3>{d.name}</h3>
                </div>
                {d.src && <a class="src" href={d.src} target="_blank" rel="noopener">Opinberar leiðbeiningar ↗</a>}
              </div>

              <div class="setup">
                <span class="tag">Fyrst</span>
                <div>
                  <p set:html={md(d.setup)} />
                  {d.base && <p class="base" set:html={md(d.base)} />}
                </div>
              </div>

              {d.rows.length > 0 && (
                <ul class="rows">
                  {d.rows.map((r) => (
                    <li class={`row k-${r.key}`}>
                      <span class="badge" set:html={ICONS[r.key]} />
                      {r.key !== 'net' && <span class="lbl">{LABELS[r.key]}</span>}
                      <span class="val" set:html={md(r.text)} />
                    </li>
                  ))}
                </ul>
              )}

              {d.apps && (
                <ul class="apps">
                  {d.apps.map((a) => (
                    <li>
                      <span class="nm"><a href={a[1]} target="_blank" rel="noopener">{a[0]}</a><span class="age">{a[2]}</span></span>
                      <span class="where" set:html={md(a[3])} />
                    </li>
                  ))}
                </ul>
              )}

              {d.scenario && (
                <div class="scenario">
                  <h4>{d.scenario.title}</h4>
                  <ol class="steps">
                    {d.scenario.steps.map((s) => <li><div set:html={md(s)} /></li>)}
                  </ol>
                </div>
              )}

              {hasDetails(d) && (
                <details>
                  <summary>Nánari leiðbeiningar</summary>
                  <div class="det">
                    {d.steps && (
                      <>
                        <h4>{d.detailsTitle ?? 'Uppsetning skref fyrir skref'}</h4>
                        <ol class="steps">
                          {d.steps.map((s) =>
                            typeof s === 'string' ? (
                              <li><div set:html={md(s)} /></li>
                            ) : (
                              <li><div><span set:html={md(s.t)} /><ul class="sub">{s.sub.map((x) => <li set:html={md(x)} />)}</ul></div></li>
                            )
                          )}
                        </ol>
                      </>
                    )}
                    {d.notes && d.notes.map((n) => <p class="note" set:html={md(n)} />)}
                    {d.monitor && (<><h4>Eftirlit</h4><ul class="plain">{d.monitor.map((x) => <li set:html={md(x)} />)}</ul></>)}
                    {d.good && (<><h4>Gott að vita</h4><ul class="plain">{d.good.map((x) => <li set:html={md(x)} />)}</ul></>)}
                  </div>
                </details>
              )}
            </article>
          ))}
        </div>
      </section>

      <section class="contact" aria-labelledby="h-contact">
        <h2 id="h-contact">Spurningar?</h2>
        <p>Netvís, Netöryggismiðstöð Íslands, aðstoðar foreldra.</p>
        <div class="row2">
          <p class="big">415 0415</p>
          <p><strong>netvis@netvis.is</strong></p>
          <p><a href="https://netvis.is/foreldrar/" target="_blank" rel="noopener">netvis.is/foreldrar</a></p>
        </div>
        <p>Í neyð: hringdu í <strong>112</strong>.</p>
        <p class="fine">Byggt á opinberum leiðbeiningum framleiðenda í október 2026. Heiti í valmyndum geta breyst með uppfærslum.</p>
      </section>
    </main>

    <div class="bar" role="region" aria-label="Vista og deila">
      <div class="bar-in">
        <div class="bar-info">
          <p id="count">Ekkert valið</p>
          <p id="status" role="status" aria-live="polite"></p>
        </div>
        <div class="actions">
          <button type="button" class="btn primary" id="print">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 9V3h10v6M7 17H5a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-2"/><path d="M7 14h10v7H7z"/></svg>
            Prenta / PDF
          </button>
          <button type="button" class="btn" id="share">Afrita hlekk</button>
        </div>
      </div>
    </div>

    <script is:inline>
      (function () {
        var KEY = 'netoryggi-val';
        var ids = Array.prototype.map.call(document.querySelectorAll('[data-device]'), function (el) { return el.dataset.device; });
        var valid = function (id) { return ids.indexOf(id) !== -1; };

        function fromHash() {
          var h = decodeURIComponent(location.hash.replace(/^#/, ''));
          if (!h) return null;
          var list = h.split(/[+,]/).filter(valid);
          return list.length ? list : null;
        }
        function fromStore() {
          try { var v = JSON.parse(localStorage.getItem(KEY)); if (Array.isArray(v)) return v.filter(valid); } catch (e) {}
          return [];
        }
        var selected = new Set(fromHash() || fromStore());

        function persist() {
          var list = ids.filter(function (id) { return selected.has(id); });
          try { localStorage.setItem(KEY, JSON.stringify(list)); } catch (e) {}
          try { history.replaceState(null, '', list.length ? '#' + list.join('+') : location.pathname); } catch (e) {}
        }

        function render() {
          var n = 0;
          document.querySelectorAll('[data-device]').forEach(function (card) {
            var on = selected.has(card.dataset.device);
            card.classList.toggle('on', on);
            if (on) n++;
          });
          document.querySelectorAll('#picker input').forEach(function (i) { i.checked = selected.has(i.value); });
          document.getElementById('empty').hidden = n > 0;
          document.getElementById('count').textContent = n === 0 ? 'Ekkert valið' : n + (n === 1 ? ' valið' : ' valin');
          document.getElementById('print').disabled = n === 0;
          document.getElementById('share').disabled = n === 0;
        }
        function status(msg) { document.getElementById('status').textContent = msg || ''; }

        document.getElementById('picker').addEventListener('change', function (e) {
          var t = e.target;
          if (!t || t.type !== 'checkbox') return;
          if (t.checked) selected.add(t.value); else selected.delete(t.value);
          persist(); render(); status('');
        });
        document.getElementById('clear').addEventListener('click', function () {
          selected.clear(); persist(); render(); status('');
        });

        var opened = [];
        window.addEventListener('beforeprint', function () {
          opened = [];
          document.querySelectorAll('.card.on details:not([open])').forEach(function (d) { d.open = true; opened.push(d); });
        });
        window.addEventListener('afterprint', function () {
          opened.forEach(function (d) { d.open = false; });
          opened = [];
        });
        document.getElementById('print').addEventListener('click', function () {
          status('Veldu „Save as PDF“ (Vista sem PDF) í prentglugganum.');
          window.print();
        });

        document.getElementById('share').addEventListener('click', function () {
          var url = location.href;
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(url).then(function () { status('Hlekkurinn er afritaður. Hann opnar síðuna með sama vali.'); },
              function () { status(url); });
          } else {
            status(url);
          }
        });

        window.addEventListener('hashchange', function () {
          var h = fromHash();
          if (h) { selected = new Set(h); render(); }
        });

        render();
      })();
    </script>
  </body>
</html>
