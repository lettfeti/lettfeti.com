---
// Private bookshelf. The page itself is generic: no titles, names or file links.
// "Sign in with Google" → /api/baekur checks the e-mail against an allowlist and
// returns the books with links that expire in two hours.
const clientId = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID ?? '';
---
<!doctype html>
<html lang="is">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Bókahillan</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,600;0,9..144,900;1,9..144,600&family=Nunito:wght@500;700;800&display=swap" rel="stylesheet" />
    <script src="https://accounts.google.com/gsi/client" async defer></script>
    <style is:global>
      :root {
        --sky1: #0d1330; --sky2: #2a1b4a; --sky3: #5b2a5e;
        --ink: #fff8ec; --muted: #c9c2e0; --gold: #ffcf4a; --gold2: #ff9f2e;
        --wood1: #8a5a32; --wood2: #6b4223; --wood3: #4b2d17;
      }
      * { box-sizing: border-box; }
      html { background: var(--sky1); }
      body {
        margin: 0; min-height: 100vh; color: var(--ink);
        font: 500 17px/1.5 'Nunito', system-ui, sans-serif;
        background:
          radial-gradient(1.5px 1.5px at 12% 18%, #fff 50%, transparent 51%),
          radial-gradient(1px 1px at 28% 72%, #fff 50%, transparent 51%),
          radial-gradient(2px 2px at 44% 12%, #fff6c8 50%, transparent 51%),
          radial-gradient(1px 1px at 63% 34%, #fff 50%, transparent 51%),
          radial-gradient(1.5px 1.5px at 78% 9%, #fff 50%, transparent 51%),
          radial-gradient(1px 1px at 88% 58%, #fff 50%, transparent 51%),
          radial-gradient(1.5px 1.5px at 7% 52%, #fff6c8 50%, transparent 51%),
          radial-gradient(1px 1px at 52% 88%, #fff 50%, transparent 51%),
          radial-gradient(1px 1px at 94% 82%, #fff 50%, transparent 51%),
          radial-gradient(1200px 600px at 50% -10%, rgba(255, 190, 90, .18), transparent 60%),
          linear-gradient(170deg, var(--sky1) 0%, var(--sky2) 55%, var(--sky3) 100%);
        background-attachment: fixed;
      }
      main { max-width: 1040px; margin: 0 auto;
             padding: 56px max(18px, env(safe-area-inset-right, 0px)) 72px max(18px, env(safe-area-inset-left, 0px)); }
      header { text-align: center; margin-bottom: 40px; }
      .moon { font-size: 44px; line-height: 1; filter: drop-shadow(0 0 18px rgba(255, 207, 74, .55)); }
      h1 { font-family: 'Fraunces', Georgia, serif; font-weight: 900; font-size: clamp(2.6rem, 7vw, 4.4rem);
           letter-spacing: -.02em; margin: 10px 0 4px; line-height: 1;
           background: linear-gradient(180deg, #fff6d8 0%, var(--gold) 60%, var(--gold2) 100%);
           -webkit-background-clip: text; background-clip: text; color: transparent;
           text-shadow: 0 6px 40px rgba(255, 180, 60, .25); }
      .tag { font-family: 'Fraunces', Georgia, serif; font-style: italic; color: var(--muted); font-size: 1.15rem; margin: 0; }

      #gate { display: flex; flex-direction: column; align-items: center; gap: 18px; margin-top: 8px; }
      .gatecard { background: rgba(255, 255, 255, .07); border: 1px solid rgba(255, 255, 255, .14); backdrop-filter: blur(6px);
                  border-radius: 22px; padding: 26px 28px; text-align: center; max-width: 420px; }
      .gatecard p { margin: 0 0 16px; color: var(--muted); }
      #signin { display: flex; justify-content: center; min-height: 44px; }
      .msg { color: #ffb4a8; text-align: center; margin: 14px 0 0; }

      .who { text-align: center; color: var(--muted); font-size: .95rem; margin: -18px 0 34px; }
      .who button { background: none; border: 0; padding: 0; color: var(--gold); font: inherit; font-weight: 800; cursor: pointer; }
      .who button:hover { text-decoration: underline; }

      .shelf { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 0; }
      .item { display: flex; flex-direction: column; min-width: 0; }
      .stand { position: relative; height: 380px; display: flex; align-items: flex-end; justify-content: center;
               padding: 0 24px 22px; perspective: 1400px; }
      .stand::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 26px;
                      background: linear-gradient(180deg, #b07a47 0%, var(--wood1) 18%, var(--wood2) 70%, var(--wood3) 100%);
                      box-shadow: 0 18px 30px rgba(0, 0, 0, .55), inset 0 2px 0 rgba(255, 220, 170, .35); }
      .stand::before { content: ''; position: absolute; left: 8%; right: 8%; bottom: 22px; height: 30px;
                       background: radial-gradient(50% 100% at 50% 100%, rgba(0, 0, 0, .55), transparent 70%); }
      .cover { position: relative; z-index: 1; display: block; height: 320px; transform-style: preserve-3d;
               transform: rotateY(-16deg) rotateX(2deg); transform-origin: left center;
               transition: transform .45s cubic-bezier(.2, .8, .2, 1), filter .45s; border-radius: 3px 8px 8px 3px;
               box-shadow: 22px 26px 34px rgba(0, 0, 0, .55), 4px 4px 0 rgba(0, 0, 0, .15); }
      .cover img { display: block; height: 100%; width: auto; max-width: 100%; border-radius: 3px 8px 8px 3px; }
      .cover::before { content: ''; position: absolute; inset: 0 auto 0 0; width: 16px; border-radius: 3px 0 0 3px;
                       background: linear-gradient(90deg, rgba(255, 255, 255, .45), rgba(0, 0, 0, .35) 45%, rgba(255, 255, 255, .12));
                       pointer-events: none; }
      .cover::after { content: ''; position: absolute; top: 4px; bottom: 4px; right: -9px; width: 9px; border-radius: 0 3px 3px 0;
                      background: repeating-linear-gradient(180deg, #fbf5e6 0 2px, #e2d7c0 2px 3px); transform: skewY(-12deg);
                      transform-origin: left; pointer-events: none; }
      .item:hover .cover, .item:focus-within .cover { transform: rotateY(-3deg) translateY(-14px); filter: brightness(1.06); }

      .info { padding: 22px 24px 40px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 6px; }
      .info h2 { font-family: 'Fraunces', Georgia, serif; font-weight: 600; font-size: 1.55rem; line-height: 1.15; margin: 0;
                 text-wrap: balance; }
      .info p { margin: 0; color: var(--muted); font-size: .95rem; }
      .btns { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; margin-top: 12px; }
      .btn { display: inline-flex; align-items: center; gap: 8px; padding: 11px 20px; border-radius: 999px; text-decoration: none;
             font-weight: 800; font-size: .98rem; transition: transform .15s, box-shadow .15s; }
      .btn.primary { color: #2a1600; background: linear-gradient(180deg, #ffe07a, var(--gold) 55%, var(--gold2));
                     box-shadow: 0 6px 18px rgba(255, 160, 40, .35), inset 0 1px 0 rgba(255, 255, 255, .6); }
      .btn.ghost { color: var(--ink); border: 2px solid rgba(255, 207, 74, .7); }
      .btn:hover { transform: translateY(-2px); }
      .btn:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }
      .note { text-align: center; color: var(--muted); font-size: .85rem; opacity: .8; margin-top: 8px; }
      [hidden] { display: none !important; }

      @media (max-width: 640px) {
        main { padding-top: 36px; }
        .stand { height: 300px; }
        .cover { height: 250px; }
      }
      @media (prefers-reduced-motion: reduce) { .cover, .btn { transition: none; } }
    </style>
  </head>
  <body>
    <main>
      <header>
        <div class="moon" aria-hidden="true">🌙</div>
        <h1>Bókahillan</h1>
        <p class="tag">Sögur fyrir svefninn og alla hina daga</p>
      </header>

      <section id="gate">
        <div class="gatecard">
          <p>Skráðu þig inn með Google til að opna hilluna.</p>
          <div id="signin" data-client={clientId}></div>
        </div>
      </section>
      <p class="msg" id="msg" hidden></p>

      <p class="who" id="who" hidden></p>
      <section class="shelf" id="shelf" hidden></section>
      <p class="note" id="note" hidden>Tenglarnir gilda í tvær klukkustundir. Endurhladdu síðuna til að fá nýja.</p>
    </main>

    <script is:inline>
      (function () {
        var signin = document.getElementById('signin');
        var clientId = signin.dataset.client;
        var msg = document.getElementById('msg');
        function say(t) { msg.textContent = t; msg.hidden = !t; }
        if (!clientId) { say('Innskráningin er ekki tilbúin enn.'); return; }

        function el(tag, cls, text) { var e = document.createElement(tag); if (cls) e.className = cls; if (text) e.textContent = text; return e; }

        function show(data) {
          var shelf = document.getElementById('shelf');
          shelf.innerHTML = '';
          data.baekur.forEach(function (b) {
            var item = el('article', 'item');
            var stand = el('div', 'stand');
            var first = (b.utgafur && b.utgafur[0]) ? b.utgafur[0].pdf : '#';
            var cover = el('a', 'cover'); cover.href = first; cover.target = '_blank'; cover.rel = 'noopener';
            cover.setAttribute('aria-label', 'Opna ' + b.titill);
            var img = el('img'); img.src = b.kapa; img.alt = ''; img.decoding = 'async';
            cover.append(img); stand.append(cover);
            var info = el('div', 'info');
            info.append(el('h2', '', b.titill));
            if (b.lysing) info.append(el('p', '', b.lysing));
            var btns = el('div', 'btns');
            (b.utgafur || []).forEach(function (u, i) {
              var a = el('a', 'btn ' + (i === 0 ? 'primary' : 'ghost'), u.heiti);
              a.href = u.pdf; a.target = '_blank'; a.rel = 'noopener';
              btns.append(a);
            });
            info.append(btns);
            item.append(stand, info);
            shelf.append(item);
          });
          var who = document.getElementById('who');
          who.textContent = 'Innskráð: ' + data.netfang + ' · ';
          var out = el('button', '', 'Skrá út'); out.type = 'button';
          out.onclick = function () { try { google.accounts.id.disableAutoSelect(); } catch (e) {} location.reload(); };
          who.append(out);
          document.getElementById('gate').hidden = true;
          who.hidden = false; shelf.hidden = false; document.getElementById('note').hidden = false;
        }
        window.__baekurShow = show; // used only by local previews

        function onCredential(resp) {
          say('');
          fetch('/api/baekur', { method: 'POST', headers: { 'Content-Type': 'application/json' },
                                 body: JSON.stringify({ credential: resp.credential }) })
            .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
            .then(function (x) { if (x.ok) show(x.j); else say(x.j.error || 'Eitthvað fór úrskeiðis.'); })
            .catch(function () { say('Gat ekki tengst. Reyndu aftur.'); });
        }

        function init() {
          if (!window.google || !google.accounts) return setTimeout(init, 100);
          google.accounts.id.initialize({ client_id: clientId, callback: onCredential, auto_select: true });
          google.accounts.id.renderButton(signin, { theme: 'filled_black', size: 'large', shape: 'pill', text: 'signin_with', locale: 'is' });
          google.accounts.id.prompt();
        }
        init();
      })();
    </script>
  </body>
</html>
